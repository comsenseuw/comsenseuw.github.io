---
const year = new Date().getFullYear();
---

<footer id="contact">
  <div class="container section contact">
    <h2 class="section-title">Contact</h2>
    <p>
      Reach me out if you like coffee and want to connect with me. My inbox is always open
      whether it's a question, an opportunity, or just to say hi.
    </p>
    <a href="mailto:thidayat170@gmail.com" class="btn">Say hello</a>
  </div>
  <div class="bottom">
    <p>Designed &amp; built by TH &copy; {year}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }

  .contact {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .contact .section-title {
    margin-bottom: 0;
  }

  .contact .section-title::after {
    margin-inline: auto;
  }

  .contact p {
    max-width: 32rem;
    color: var(--muted);
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .btn:hover {
    background: var(--accent-hover);
    color: var(--bg);
  }

  .bottom {
    padding-block: 1.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
  }
</style>
